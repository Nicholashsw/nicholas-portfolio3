---
import { ui, type LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionCard from '@/components/section-card.astro';
import { EmptyState } from '@/components/empty-state';
import Heading from '@/components/Heading.astro';
import { Badge } from '@/components/ui/badge';
import type { TranslatedProject } from '../type';

export type Props = {
  projects: Array<TranslatedProject>;
  lang: LanguageCode;
};

const { projects, lang } = Astro.props;
const t = (ui as Record<string, any>)[lang];
const projectsPageTranslations = t.projectsPage;
const d = t.projectDetailPage ?? {};

// In-progress work is not listed; flagships first, then by rank.
const listed = projects
  .filter((p) => (p.status ?? 'published') !== 'in-progress')
  .sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99));
const flagships = listed.filter((p) => p.featured);
const others = listed.filter((p) => !p.featured);

const statusLabel = (p: TranslatedProject) =>
  p.status === 'negative-result'
    ? (d.statusNegativeResult ?? 'Negative result')
    : null;
const href = (p: TranslatedProject) =>
  getRelativeLocaleUrl(lang, `/projects/${p.slug}`);
---

<div class="py-12 md:py-16">
  <Heading title={projectsPageTranslations?.title ?? 'Research and projects'} />
  {
    listed.length > 0 ? (
      <>
        {flagships.length > 0 && (
          <section class="mb-14">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {flagships.map((project) => (
                <a
                  href={href(project)}
                  aria-label={`View project ${project.title}`}
                  class="flex rounded-lg transition-shadow duration-200 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                >
                  <SectionCard
                    title={project.title}
                    categoryText={project.capability ?? project.categoryText}
                    className="w-full"
                    classNameTitle="text-xl"
                    tags={project.tags ?? []}
                    imageUrl={project.imageUrl}
                    imageAltText={project.imageAltText}
                  >
                    <p class="text-sm text-muted-foreground">
                      {project.description}
                    </p>
                  </SectionCard>
                </a>
              ))}
            </div>
          </section>
        )}
        {others.length > 0 && (
          <section>
            <h2 class="text-xl font-semibold mb-6 text-muted-foreground uppercase tracking-wide">
              Further research and systems
            </h2>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {others.map((project) => (
                <a
                  href={href(project)}
                  aria-label={`View project ${project.title}`}
                  class="flex rounded-lg transition-shadow duration-200 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                >
                  <SectionCard
                    title={project.title}
                    categoryText={project.capability ?? project.categoryText}
                    className="w-full"
                    classNameTitle="text-xl"
                    tags={project.tags ?? []}
                    imageUrl={project.imageUrl}
                    imageAltText={project.imageAltText}
                  >
                    {statusLabel(project) && (
                      <div class="mb-2">
                        <Badge variant="outline">{statusLabel(project)}</Badge>
                      </div>
                    )}
                    <p class="text-sm text-muted-foreground">
                      {project.description}
                    </p>
                  </SectionCard>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <EmptyState
        title={projectsPageTranslations?.noProjects}
        description={projectsPageTranslations?.noProjectsDescription}
      />
    )
  }
</div>
