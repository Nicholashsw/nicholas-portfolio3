---
import Heading from '@/components/Heading.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { type LanguageCode, defaultLanguage, type ui } from '@/i18n/ui';
import { Image } from 'astro:assets';
import { Code, ExternalLink, FileText } from 'lucide-react';
import FigureList from '../components/FigureList.astro';
import type { TranslatedProject } from '../type';

export type Props = {
  project: TranslatedProject;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { project, t, lang } = Astro.props;
const d = (t as any).projectDetailPage ?? {};
const status = project.status ?? 'published';
const statusText =
  status === 'negative-result'
    ? (d.statusNegativeResult ?? 'Negative result')
    : status === 'in-progress'
      ? (d.statusInProgress ?? 'In progress')
      : null;
const backHref = (lang !== defaultLanguage ? '/' + lang : '') + '/projects';

type Meta = { label: string; value: string; variant: 'default' | 'secondary' };
const meta: Meta[] = [];
if (project.capability)
  meta.push({
    label: d.capabilityLabel ?? 'Capability:',
    value: [project.capability, ...(project.topicLabels ?? [])].join(' · '),
    variant: 'default',
  });
if (project.categoryText)
  meta.push({
    label: d.categoryLabel ?? 'Category:',
    value: project.categoryText,
    variant: 'secondary',
  });
if (project.dateText)
  meta.push({
    label: d.dateLabel ?? 'Date:',
    value: project.dateText,
    variant: 'secondary',
  });

type Action = {
  href: string;
  text: string;
  variant: 'default' | 'secondary' | 'outline';
  icon: 'code' | 'paper' | 'link';
};
const actions: Action[] = [];
if (project.codeUrl)
  actions.push({
    href: project.codeUrl,
    text: d.viewCodeButton ?? 'View code',
    variant: 'default',
    icon: 'code',
  });
if (project.paperUrl)
  actions.push({
    href: project.paperUrl,
    text: project.paperLabel ?? d.readPaperButton ?? 'Read paper',
    variant: 'secondary',
    icon: 'paper',
  });
if (project.projectUrl)
  actions.push({
    href: project.projectUrl,
    text: d.visitProjectButton ?? 'Visit project',
    variant: 'outline',
    icon: 'link',
  });

const methodology = project.methodology ?? [];
const findings = project.findings ?? [];
const caveats = project.caveats ?? [];
// The main image is shown once at the top; do not repeat it as Figure 1.
const figures = (project.galleryImagesTranslated ?? []).filter(
  (g) => g.src.src !== project.imageUrl?.src
);
// ...but it does carry a caption, shown unnumbered under the hero.
const heroFigure = (project.galleryImagesTranslated ?? []).find(
  (g) => g.src.src === project.imageUrl?.src
);
const keyFeatures = project.keyFeaturesTranslated ?? [];
const stack = project.stack ?? [];
const papers = [
  ...(project.paperUrl
    ? [
        {
          label: project.paperLabel ?? d.readPaperButton ?? 'Read paper',
          url: project.paperUrl,
        },
      ]
    : []),
  ...(project.papers ?? []),
];
---

<div class="py-12 md:py-16">
  <article class="prose lg:prose-lg max-w-none dark:prose-invert">
    <a
      href={backHref}
      class={buttonVariants({ variant: 'ghost' }) + ' mb-6 no-underline'}
    >
      &larr; {d.backToProjects ?? 'Back to projects'}
    </a>

    <Heading title={project.title} />

    {
      project.headline && (
        <p class="lead text-lg md:text-xl text-muted-foreground -mt-2 mb-6">
          {project.headline}
        </p>
      )
    }

    <div
      class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm not-prose"
    >
      {
        meta.map((m) => (
          <div class="flex items-center gap-2">
            <span class="text-foreground">{m.label}</span>
            <Badge variant={m.variant}>{m.value}</Badge>
          </div>
        ))
      }
      {statusText && <Badge variant="outline">{statusText}</Badge>}
    </div>

    <div class="mb-8 flex flex-wrap gap-3 not-prose">
      {
        actions.map((a) => (
          <a
            href={a.href}
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({ variant: a.variant }) + ' no-underline'}
          >
            {a.icon === 'code' && <Code className="mr-2 size-4" />}
            {a.icon === 'paper' && <FileText className="mr-2 size-4" />}
            {a.icon === 'link' && <ExternalLink className="mr-2 size-4" />}
            {a.text}
          </a>
        ))
      }
    </div>

    {
      project.imageUrl && (
        <figure class="mb-10 not-prose rounded-lg border border-border/60 bg-card p-3 md:p-4">
          <div class="w-full overflow-hidden rounded-md bg-white">
            <Image
              src={project.imageUrl}
              alt={project.imageAltText}
              loading="eager"
              class="block w-full h-auto"
              widths={[640, 960, 1400]}
              sizes="(max-width: 768px) 100vw, 900px"
              quality="high"
            />
          </div>
          {heroFigure?.caption && (
            <figcaption class="mt-3 text-sm text-muted-foreground leading-relaxed">
              {heroFigure.caption}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      project.detailedDescription && (
        <section class="mb-8">
          <h2>{d.aboutTitle ?? 'About this project'}</h2>
          <p>{project.detailedDescription}</p>
        </section>
      )
    }

    {
      project.whyItMatters && (
        <section class="mb-8">
          <h2>{d.whyTitle ?? 'Why it matters'}</h2>
          <p>{project.whyItMatters}</p>
        </section>
      )
    }

    {
      methodology.length > 0 && (
        <section class="mb-8">
          <h2>{d.methodologyTitle ?? 'Methodology'}</h2>
          <ul>
            {methodology.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      findings.length > 0 && (
        <section class="mb-8">
          <h2>{d.findingsTitle ?? 'Strongest findings'}</h2>
          <ul>
            {findings.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      figures.length > 0 && (
        <FigureList title={d.figuresTitle ?? 'Figures'} images={figures} />
      )
    }

    {
      caveats.length > 0 && (
        <section class="mb-8">
          <h2>{d.caveatsTitle ?? 'Robustness and caveats'}</h2>
          <ul>
            {caveats.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      keyFeatures.length > 0 && (
        <section class="mb-8">
          <h2>{d.keyFeaturesTitle ?? 'Key features'}</h2>
          <ul class="pl-5 list-disc">
            {keyFeatures.map((feature) => (
              <li>
                <strong>{feature.title}:</strong> {feature.description}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (project.challenges || project.learnings) && (
        <div class="grid grid-cols-1 md:gap-8 md:grid-cols-2 md:mb-8 mb-4">
          {project.challenges && (
            <section>
              <h2 class="mt-0">{d.challengesTitle ?? 'Challenges'}</h2>
              <p>{project.challenges}</p>
            </section>
          )}
          {project.learnings && (
            <section>
              <h2 class="mt-0">{d.learningsTitle ?? 'Learnings'}</h2>
              <p>{project.learnings}</p>
            </section>
          )}
        </div>
      )
    }

    {
      stack.length > 0 && (
        <section class="mb-8 not-prose">
          <h2 class="text-2xl font-semibold mb-3">{d.stackTitle ?? 'Stack'}</h2>
          <div class="flex flex-wrap gap-2">
            {stack.map((s) => (
              <Badge variant="secondary">{s}</Badge>
            ))}
          </div>
        </section>
      )
    }

    {
      papers.length > 0 && (
        <section class="mb-8 not-prose">
          <h2 class="text-2xl font-semibold mb-3">
            {d.papersTitle ?? 'Papers and documents'}
          </h2>
          <ul class="space-y-2">
            {papers.map((pp) => (
              <li>
                <a
                  href={pp.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4"
                >
                  {pp.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</div>
