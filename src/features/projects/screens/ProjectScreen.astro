---
import Heading from '@/components/Heading.astro';
import { buttonVariants } from '@/components/ui/button';
import { type LanguageCode, type ui } from '@/i18n/ui';
import { Code, FileText } from 'lucide-react';
import FigureList from '../components/FigureList.astro';
import type { TranslatedProject } from '../type';

export type Props = {
  project: TranslatedProject;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { project, t } = Astro.props;
const d = (t as any).projectDetailPage ?? {};

type Action = {
  href: string;
  text: string;
  variant: 'default' | 'secondary' | 'outline';
  icon: 'code' | 'paper';
};
const actions: Action[] = [];
if (project.codeUrl)
  actions.push({
    href: project.codeUrl,
    text: d.viewCodeButton ?? 'View code',
    variant: 'default',
    icon: 'code',
  });
if (project.paperUrl)
  actions.push({
    href: project.paperUrl,
    text: project.paperLabel ?? d.readPaperButton ?? 'Read paper',
    variant: 'secondary',
    icon: 'paper',
  });
for (const pp of project.papers ?? [])
  actions.push({
    href: pp.url,
    text: pp.label,
    variant: 'outline',
    icon: 'paper',
  });

const methodology = project.methodology ?? [];
const findings = project.findings ?? [];
const caveats = project.caveats ?? [];
// The main image leads the charts; the rest follow in registry order.
const gallery = project.galleryImagesTranslated ?? [];
const figures = [
  ...gallery.filter((g) => g.src.src === project.imageUrl?.src),
  ...gallery.filter((g) => g.src.src !== project.imageUrl?.src),
];
---

<div class="py-12 md:py-16">
  <article class="prose lg:prose-lg max-w-none dark:prose-invert">
    <Heading title={project.title} />

    {
      project.headline && (
        <p class="lead text-lg md:text-xl text-muted-foreground -mt-2 mb-8">
          {project.headline}
        </p>
      )
    }

    {
      project.detailedDescription && (
        <section class="mb-8">
          <h2>{d.aboutTitle ?? 'Question'}</h2>
          <p>{project.detailedDescription}</p>
        </section>
      )
    }

    {
      methodology.length > 0 && (
        <section class="mb-8">
          <h2>{d.methodologyTitle ?? 'Methodology'}</h2>
          <ul>
            {methodology.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      findings.length > 0 && (
        <section class="mb-8">
          <h2>{d.findingsTitle ?? 'Result'}</h2>
          <ul>
            {findings.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      caveats.length > 0 && (
        <section class="mb-10">
          <h2>{d.caveatsTitle ?? 'Caveats'}</h2>
          <ul>
            {caveats.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>
      )
    }

    <FigureList images={figures} />

    {
      actions.length > 0 && (
        <div class="flex flex-wrap gap-3 not-prose">
          {actions.map((a) => (
            <a
              href={a.href}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({ variant: a.variant }) + ' no-underline'}
            >
              {a.icon === 'code' && <Code className="mr-2 size-4" />}
              {a.icon === 'paper' && <FileText className="mr-2 size-4" />}
              {a.text}
            </a>
          ))}
        </div>
      )
    }
  </article>
</div>
