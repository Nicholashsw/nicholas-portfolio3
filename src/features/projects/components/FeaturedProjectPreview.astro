---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { LanguageCode } from '@/i18n/ui';

export type Props = {
  lang: LanguageCode;
  slug: string;
  title: string;
  imageUrl?: ImageMetadata;
  imageAltText: string;
  headline?: string;
};

const {
  lang,
  slug,
  title,
  imageUrl,
  imageAltText,
  headline,
} = Astro.props;
const projectUrl = getRelativeLocaleUrl(lang, `/projects/${slug}`);
---

<a
  href={projectUrl}
  class="group relative flex flex-col w-full rounded-lg overflow-hidden border border-border/60 bg-card shadow-sm hover:shadow-lg transition-shadow focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
>
  <div class="relative w-full aspect-[16/10] bg-white overflow-hidden">
    {
      imageUrl ? (
        <Image
          src={imageUrl}
          alt={imageAltText}
          class="absolute inset-0 w-full h-full object-contain p-2 transition-transform duration-500 ease-in-out group-hover:scale-[1.03]"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
          quality="mid"
        />
      ) : (
        <div class="absolute inset-0 w-full h-full bg-muted flex items-center justify-center">
          <p class="text-muted-foreground text-sm">
            {imageAltText || 'Image not available'}
          </p>
        </div>
      )
    }
  </div>
  <div class="flex flex-col gap-2 p-5">
    <h3 class="text-xl font-semibold leading-snug">{title}</h3>
    {
      headline && (
        <p class="text-sm text-muted-foreground leading-relaxed">
          {headline}
        </p>
      )
    }
  </div>
</a>
