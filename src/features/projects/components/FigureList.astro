---
/**
 * Research charts, shown whole (object-contain) at full column width. No captions or numbering:
 * the page copy carries the argument.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Props = {
  images: Array<{
    id: string;
    src: ImageMetadata;
    alt: string;
  }>;
};

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section class="mb-10 not-prose">
      <ol class="space-y-8">
        {images.map((image, i) => (
          <li class="rounded-lg border border-border/60 bg-card p-3 md:p-4">
            <figure>
              <div class="w-full overflow-hidden rounded-md bg-white">
                <Image
                  src={image.src}
                  alt={image.alt}
                  class="block w-full h-auto"
                  widths={[640, 960, 1400]}
                  sizes="(max-width: 768px) 100vw, 900px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  quality="high"
                />
              </div>
            </figure>
          </li>
        ))}
      </ol>
    </section>
  )
}
